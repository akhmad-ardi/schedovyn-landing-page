---
import { SITE_CONFIG } from '@/data/site-config';
import { ExternalLink, BookOpen, ShieldCheck, Database, WifiOff, Heart } from 'lucide-react';
---

<footer class="border-t border-border bg-card text-card-foreground">
  <div class="px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="h-7 w-7 rounded-none border border-border bg-muted flex items-center justify-center p-1">
            <img src="/favico.svg" alt="Schedovyn Logo" class="h-5 w-5" width="20" height="20" />
          </div>
          <span class="font-heading font-bold text-base text-foreground tracking-tight">
            {SITE_CONFIG.brandName}
          </span>
          <span class="rounded-none border border-border bg-muted px-1.5 py-0.5 text-[10px] font-mono text-muted-foreground uppercase">
            {SITE_CONFIG.versionBadge}
          </span>
        </div>

        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-sm">
          Aplikasi penyusun jadwal pelajaran sekolah visual berbasis peramban dengan deteksi konflik otomatis lintas kelas.
          Berjalan 100% di perangkat Anda tanpa perlu mendaftar akun.
        </p>

        <div class="flex items-center gap-2 pt-1 text-xs text-muted-foreground font-mono">
          <span class="inline-flex items-center gap-1">
            <ShieldCheck className="h-3.5 w-3.5 text-emerald-600" aria-hidden="true" />
            <span>100% Client-Side</span>
          </span>
          <span>-</span>
          <span class="inline-flex items-center gap-1">
            <Database className="h-3.5 w-3.5 text-primary" aria-hidden="true" />
            <span>IndexedDB</span>
          </span>
          <span>-</span>
          <span class="inline-flex items-center gap-1">
            <WifiOff className="h-3.5 w-3.5 text-amber-600" aria-hidden="true" />
            <span>PWA Offline</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation & Ekosistem -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="font-heading font-bold text-xs uppercase tracking-wider text-foreground">
          Navigasi Halaman
        </h4>
        <ul class="space-y-2 text-xs font-sans text-muted-foreground">
          {SITE_CONFIG.navAnchors.map((item) => (
            <li>
              <a href={item.href} class="hover:text-foreground hover:underline transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Ekosistem Aplikasi & Panduan -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="font-heading font-bold text-xs uppercase tracking-wider text-foreground">
          Ekosistem Schedovyn
        </h4>
        <ul class="space-y-2 text-xs font-sans text-muted-foreground">
          <li>
            <a
              href={SITE_CONFIG.appUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-foreground font-semibold hover:text-primary transition-colors"
            >
              <span>Aplikasi Utama (Editor Jadwal)</span>
              <ExternalLink className="h-3 w-3" aria-hidden="true" />
            </a>
            <p class="text-[11px] text-muted-foreground mt-0.5">
              Mulai susun jadwal pelajaran sekolah secara gratis tanpa akun.
            </p>
          </li>
          <li class="pt-1">
            <a
              href={SITE_CONFIG.guideUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-primary font-semibold hover:underline transition-colors"
            >
              <BookOpen className="h-3 w-3" aria-hidden="true" />
              <span>Portal Panduan Pemakaian</span>
              <ExternalLink className="h-3 w-3" aria-hidden="true" />
            </a>
            <p class="text-[11px] text-muted-foreground mt-0.5">
              Tutorial langkah demi langkah, kiat konfigurasi, dan trik ekspor.
            </p>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="border-t border-border/60 pt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-muted-foreground">
      <div class="font-mono text-[11px]">
        &copy; 2026 {SITE_CONFIG.brandName}. Seluruh hak cipta dilindungi.
      </div>
      <div class="text-[11px] text-muted-foreground">
        Dibangun dengan presisi untuk kurikulum sekolah di Indonesia. Bebas biaya dan privasi terjamin.
      </div>
    </div>
  </div>
</footer>
