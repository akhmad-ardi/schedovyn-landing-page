---
import { SITE_CONFIG } from '@/data/site-config';
import ThemeToggle from '@/components/layout/ThemeToggle';
import { ExternalLink, BookOpen, Calendar, Menu } from 'lucide-react';
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-md">
  <div class="px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    <!-- Brand & Version Badge -->
    <a href="/" class="flex items-center gap-2.5 group select-none">
      <div class="h-8 w-8 rounded-none border border-border bg-muted flex items-center justify-center p-1 group-hover:border-primary transition-colors">
        <img src="/favico.svg" alt="Schedovyn Logo" class="h-6 w-6" width="24" height="24" />
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-heading font-bold text-lg tracking-tight text-foreground group-hover:text-primary transition-colors">
          {SITE_CONFIG.brandName}
        </span>
        <span class="hidden md:inline-flex items-center rounded-none border border-border bg-muted/60 px-1.5 py-0.5 text-[10px] font-mono font-medium text-muted-foreground uppercase tracking-wider">
          {SITE_CONFIG.versionBadge}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Anchors -->
    <nav class="hidden lg:flex items-center gap-1 font-sans text-xs font-medium text-muted-foreground" aria-label="Navigasi Utama">
      {SITE_CONFIG.navAnchors.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 rounded-none text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={SITE_CONFIG.guideUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-none text-primary hover:text-primary/90 hover:bg-primary/5 transition-colors font-semibold"
      >
        <BookOpen className="h-3.5 w-3.5" aria-hidden="true" />
        <span>Panduan Pemakaian</span>
      </a>
    </nav>

    <!-- Right Controls: Theme Toggle & Primary App CTA -->
    <div class="flex items-center gap-2">
      <ThemeToggle client:load />

      <a
        href={SITE_CONFIG.appUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 h-9 px-3.5 sm:px-4 rounded-none bg-primary text-primary-foreground hover:bg-primary/90 border border-primary font-sans text-xs sm:text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring select-none shadow-xs"
      >
        <span>Buka Aplikasi</span>
        <ExternalLink className="h-3.5 w-3.5 hidden sm:inline-block" aria-hidden="true" />
      </a>
    </div>
  </div>

  <!-- Mobile Sub-navigation Bar -->
  <div class="lg:hidden border-t border-border/60 bg-muted/20 px-3 py-1.5 overflow-x-auto">
    <div class="flex items-center gap-1 text-[11px] font-medium text-muted-foreground whitespace-nowrap min-w-max">
      {SITE_CONFIG.navAnchors.map((item) => (
        <a
          href={item.href}
          class="px-2.5 py-1 rounded-none hover:bg-muted hover:text-foreground transition-colors"
        >
          {item.label}
        </a>
      ))}
      <span class="text-border">|</span>
      <a
        href={SITE_CONFIG.guideUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-none text-primary hover:bg-primary/5 font-semibold"
      >
        <BookOpen className="h-3 w-3" aria-hidden="true" />
        <span>Panduan</span>
      </a>
    </div>
  </div>
</header>
