---
import { SITE_CONFIG } from '@/data/site-config';
import { Badge } from '@/components/ui/badge';
import { XCircle, CheckCircle2, ArrowRight } from 'lucide-react';
---

<section class="border-b border-border bg-background py-14 sm:py-18 lg:py-24">
  <div class="px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Section Header -->
    <div class="max-w-2xl space-y-3">
      <div class="text-xs font-mono uppercase tracking-wider text-muted-foreground">
        <span>[01 / MASALAH VS SOLUSI]</span>
        <span class="mx-1">:</span>
        <span>Perbandingan Alur Kerja</span>
      </div>
      <h2 class="font-heading font-bold text-2xl sm:text-3xl lg:text-4xl text-foreground tracking-tight">
        Tinggalkan Cara Lama yang Rentan Bentrokan Jadwal.
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
        Menyusun jadwal puluhan guru dengan lembar spreadsheet manual sering kali berujung pada tabrakan jam mengajar. Schedovyn mengotomatisasi pemeriksaan presisi dalam hitungan milidetik.
      </p>
    </div>

    <!-- Comparison Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {SITE_CONFIG.problemSolutions.map((item, index) => {
        const stepNum = `0${index + 1}`;
        return (
          <div class="rounded-none border border-border bg-card flex flex-col justify-between shadow-none">
            <!-- Card Header -->
            <div class="p-5 border-b border-border bg-muted/30 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-primary tabular-nums">{stepNum}</span>
                <span class="font-heading font-semibold text-xs text-foreground uppercase tracking-wider">{item.aspect}</span>
              </div>
              <Badge variant="primary" className="text-[10px]">
                {item.benefitBadge}
              </Badge>
            </div>

            <!-- Card Body: Problem vs Solution -->
            <div class="p-5 space-y-4 flex-1 flex flex-col justify-between">
              <!-- Old Way -->
              <div class="space-y-1.5 p-3 rounded-none border border-red-500/30 bg-red-500/5">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-red-700 dark:text-red-400">
                  <XCircle className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  <span>Cara Lama (Manual / Spreadsheet)</span>
                </div>
                <p class="text-xs text-muted-foreground leading-relaxed pl-5">
                  {item.oldWayProblem}
                </p>
              </div>

              <!-- Schedovyn Solution -->
              <div class="space-y-1.5 p-3 rounded-none border border-emerald-500/40 bg-emerald-500/5">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-800 dark:text-emerald-300">
                  <CheckCircle2 className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  <span>Cara Kerja Cerdas Schedovyn</span>
                </div>
                <p class="text-xs text-foreground/90 leading-relaxed pl-5 font-medium">
                  {item.schedovynSolution}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- 4 Validation Status Showcase Bar -->
    <div class="rounded-none border border-border bg-muted/20 p-5 space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/60 pb-3">
        <div class="font-heading font-semibold text-sm text-foreground">
          4 Status Validasi Transparan Schedovyn
        </div>
        <div class="text-xs text-muted-foreground font-mono">
          Kepastian status jadwal tanpa keraguan tebak-tebakan
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="p-3 rounded-none border border-red-600 dark:border-red-500 bg-red-500/10 space-y-1">
          <div class="text-xs font-bold text-red-700 dark:text-red-300">
            1. Konflik Ditemukan
          </div>
          <p class="text-[11px] text-muted-foreground">
            Bentrokan waktu guru, ruangan, atau jam istirahat terdeteksi di grid.
          </p>
        </div>

        <div class="p-3 rounded-none border border-amber-600 dark:border-amber-500 bg-amber-500/10 space-y-1">
          <div class="text-xs font-bold text-amber-800 dark:text-amber-300">
            2. Belum Lengkap
          </div>
          <p class="text-[11px] text-muted-foreground">
            Bebas bentrokan, namun masih ada jam pelajaran yang belum ditempatkan.
          </p>
        </div>

        <div class="p-3 rounded-none border border-sky-600 dark:border-sky-400 bg-sky-500/10 space-y-1">
          <div class="text-xs font-bold text-sky-800 dark:text-sky-300">
            3. Tidak Ada Konflik pada Data Saat Ini
          </div>
          <p class="text-[11px] text-muted-foreground">
            Sesi yang terpasang aman dan valid, penyusunan jadwal sedang berlangsung.
          </p>
        </div>

        <div class="p-3 rounded-none border border-emerald-600 dark:border-emerald-500 bg-emerald-500/10 space-y-1">
          <div class="text-xs font-bold text-emerald-800 dark:text-emerald-300">
            4. Jadwal Lengkap dan Valid
          </div>
          <p class="text-[11px] text-muted-foreground">
            Seluruh target alokasi kurikulum terpenuhi dan 0 bentrokan terdeteksi.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
